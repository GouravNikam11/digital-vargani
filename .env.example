# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Auth — generate a long random secret for production
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PostgreSQL — pick one: local Docker or Supabase
# Local: docker compose up -d
DATABASE_URL=postgresql://vargani:vargani@localhost:5432/vargani?schema=public
DIRECT_URL=postgresql://vargani:vargani@localhost:5432/vargani?schema=public

# Supabase: Project Settings → Database → Connect → URI
# DATABASE_URL = Transaction pooler (port 6543) for the Next.js app
# DIRECT_URL   = Session pooler (port 5432) for prisma migrate and seed
# If the password contains # or @, URL-encode them (# → %23, @ → %40)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Object storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Optional S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional future WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
