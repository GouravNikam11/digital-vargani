# Application
APP_URL=http://localhost:3000
NODE_ENV=development

# Auth — generate a long random secret for production
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# PostgreSQL
DATABASE_URL=postgresql://vargani:vargani@localhost:5432/vargani?schema=public

# Object storage: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads

# Optional S3-compatible storage (used when STORAGE_DRIVER=s3)
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# Optional future WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
